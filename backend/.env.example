# Plantilla de variables de entorno del backend.
# Copiá este archivo como ".env" y completá los valores segun tu entorno.
#   cp .env.example .env   (o copialo a mano en Windows)

# Puerto donde escucha el backend
PORT=3001

# Entorno de ejecución: development | production
NODE_ENV=development

# Origen permitido por CORS.
# En desarrollo: la URL del frontend (Vite) -> http://localhost:5173
# En producción (Parte 23): el dominio real del taller -> https://tu-dominio.com
CORS_ORIGIN=http://localhost:5173
